{
    "name": "easy-binary",
    "displayName": "Easy Binary (Auto Compiler & Runtime Provisioner)",
    "description": "Automatic compiler & runtime installer via Winget for Windows (GCC, Python, JDK, Go, Node.js, Rust, .NET).",
    "version": "0.1.1",
    "publisher": "loerei",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "compiler installer",
        "winget",
        "mingw gcc",
        "python setup",
        "jdk setup",
        "zero setup"
    ],
    "icon": "icon.png",
    "galleryBanner": {
        "color": "#1a1a1a",
        "theme": "dark"
    },
    "homepage": "https://github.com/loerei/easy-binary#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/loerei/easy-binary.git"
    },
    "bugs": {
        "url": "https://github.com/loerei/easy-binary/issues"
    },
    "contributes": {
        "configuration": {
            "title": "Easy Binary",
            "properties": {
                "easy-binary.autoInstallMissingCompilers": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically prompt or install missing compilers via Winget when pressing F5."
                }
            }
        }
    }
}
